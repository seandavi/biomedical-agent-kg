# Copy to .env and adjust. Auth is via ADC, not a key in this file:
#   gcloud auth application-default login

# --- Google Cloud / Vertex AI ---
GOOGLE_CLOUD_PROJECT=bioc-u24
GOOGLE_CLOUD_LOCATION=us-central1
# Alternative to Vertex: AI Studio key (leave project unset to use this)
# GOOGLE_API_KEY=

# --- Pipeline ---
KG_BACKEND=mock              # mock | vertex
KG_GEMINI_MODEL=gemini-2.5-flash   # verify current latest Flash in the model garden
KG_LIST_PATH=list.md
KG_OUT_PATH=data/graph.json
