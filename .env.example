# agentkg configuration. Copy to .env and adjust; .env is gitignored.
# Layering: .env > process env > code defaults (src/agentkg/config.py).

# ─── Google Cloud / Vertex AI (live extraction backend) ───────────────────────
# Auth is via Application Default Credentials, NOT a key in this file:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=bioc-u24
# Region. Gemini 3.x models are served ONLY from the 'global' endpoint on Vertex —
# regional endpoints (e.g. us-central1) return 404 for them.
GOOGLE_CLOUD_LOCATION=global
# Alternative to Vertex: Google AI Studio key. Leave GOOGLE_CLOUD_PROJECT unset to use it.
# GOOGLE_API_KEY=

# ─── Pipeline ─────────────────────────────────────────────────────────────────
KG_BACKEND=mock                      # mock (offline) | vertex (live Gemini)
KG_GEMINI_MODEL=gemini-3.1-flash-lite   # classify + facet tier (verify it's callable)
KG_PROFILE_MODEL=gemini-3.1-flash-lite  # prose tier — bump to a larger model if needed
KG_LIST_PATH=list.md                 # local crawl input (ignored when --sources is used)
KG_OUT_PATH=data/graph.json          # committed catalog artifact
KG_REVIEW_PATH=_review.json          # gitignored prompt-failure signal log
KG_LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
KG_COCITE_MIN=2                      # min catalog papers an external paper must link to
                                     # enter the cocitation overlay (raise to 3 to trim)
KG_DISCOVER_ROUNDS=0                 # citation-based agent discovery rounds (ADR 0003);
                                     # 0=off, 1=single pass; needs --sources + a token
KG_DISCOVER_CAP=                     # optional cap on cocitation candidates per round

# ─── GitHub (README crawl + repo health) ──────────────────────────────────────
# Unauthenticated GitHub is 60 requests/hour — far too few for a full crawl, so READMEs
# get rate-limited and grounding goes thin. A token (classic PAT, public-read scope is
# enough) raises the limit to 5,000/hour. Generate at github.com/settings/tokens.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── OpenAlex (polite pool; optional) ─────────────────────────────────────────
# OPENALEX_MAILTO=you@example.com
